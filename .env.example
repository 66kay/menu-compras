# Variables de Entorno para Menú & Compras
# NOTA: Estas variables solo se usan en el backend serverless (/api/precios) en Vercel o en desarrollo local.
# NUNCA compartas ni subas tu token real de Apify al repositorio.

# Token de API de Apify (Consíguelo en https://console.apify.com/account/integrations)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del actor de Apify para catálogo/búsqueda de Líder Chile (opcional si se usa el predeterminado)
APIFY_LIDER_ACTOR_ID=jupri/lider-scraper

# Sucursal predeterminada de Líder (Osorno)
VITE_DEFAULT_STORE_NAME="Líder Casona, Osorno"
